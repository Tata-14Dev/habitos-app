# Copiá este archivo a .env.local y completá con los datos de tu proyecto de Supabase
# (Project Settings → API). Sin estas variables la app funciona solo en local, sin sincronizar.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
# Clave pública VAPID para notificaciones push (se genera con `npm run vapid`).
VITE_VAPID_PUBLIC_KEY=
